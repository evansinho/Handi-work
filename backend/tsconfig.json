  "compilerOptions": {
    "module": "commonjs", // Use "commonjs" for Node compatibility
    "target": "es6",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "src/routes/authRoutes.tsx"],
  "exclude": ["node_modules"]
}
